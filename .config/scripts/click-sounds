#!/usr/bin/env python3
"""CLI control for the click-sound daemon.

Usage:
  click-sounds toggle                 start daemon if stopped, stop if running
  click-sounds start                  start the daemon
  click-sounds stop                   stop the daemon
  click-sounds status                 show running state, profiles, volumes, pitch
  click-sounds list                   list available profiles
  click-sounds profile [name]         list profiles, or switch profile
  click-sounds cycle                  advance both keyboard and mouse profiles
  click-sounds volume <k> [value]     show or set volume (key_down|key_up|mouse)
  click-sounds pitch [on|off|<lo>,<hi>]  show, toggle, or set pitch range
"""

import os
import re
import subprocess
import sys
import time
import tomllib
from pathlib import Path

CONFIG_PATH = Path.home() / ".config/click-sounds/config.toml"
PROFILES_DIR = Path.home() / ".config/click-sounds/profiles"
CACHE_DIR = Path.home() / ".cache/click-sounds"
CONTROL_PATH = CACHE_DIR / "control"
STATUS_PATH = CACHE_DIR / "status"
PID_PATH = CACHE_DIR / "daemon.pid"
DAEMON_PATH = Path.home() / ".config/scripts/click-sound-daemon.py"


# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------


def daemon_running():
    """Check the daemon via its PID file (robust against pgrep self-matches)."""
    try:
        pid = int(PID_PATH.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            cmdline = f.read().decode(errors="replace")
        return "click-sound-daemon.py" in cmdline
    except OSError:
        return False


def daemon_pid():
    try:
        return int(PID_PATH.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None


def notify(msg):
    try:
        subprocess.run(["notify-send", "Click Sounds", msg, "-t", "1500"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def send_command(cmd):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    CONTROL_PATH.write_text(cmd + "\n", encoding="utf-8")


def list_profiles():
    return sorted(
        p.name for p in PROFILES_DIR.iterdir()
        if p.is_dir() and (p / "profile.yaml").exists()
    )


def is_mouse_profile(name):
    """True if the profile's profile.yaml declares device: mouse."""
    yaml_path = PROFILES_DIR / name / "profile.yaml"
    try:
        import yaml
        with open(yaml_path, "r", encoding="utf-8") as f:
            data = yaml.safe_load(f) or {}
        return (data.get("profile") or {}).get("device") == "mouse"
    except Exception:
        return False


def read_config():
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "rb") as f:
                return tomllib.load(f)
        except Exception:
            pass
    return {}


def set_toml_value(path, section, key, value):
    """Best-effort line-based edit of a TOML file (preserves other content)."""
    try:
        text = path.read_text(encoding="utf-8") if path.exists() else ""
    except OSError:
        return
    lines = text.splitlines()
    out = []
    in_section = False
    section_found = False
    key_found = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_section = stripped == "[%s]" % section
            if in_section:
                section_found = True
            out.append(line)
            continue
        if in_section and re.match(r"^%s\s*=" % re.escape(key), stripped):
            out.append("%s = %s" % (key, value))
            key_found = True
            continue
        out.append(line)
    if not key_found:
        if not section_found:
            out.append("[%s]" % section)
            out.append("%s = %s" % (key, value))
        else:
            for i, line in enumerate(out):
                if line.strip() == "[%s]" % section:
                    out.insert(i + 1, "%s = %s" % (key, value))
                    break
    try:
        path.write_text("\n".join(out) + "\n", encoding="utf-8")
    except OSError:
        pass


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------


def cmd_start():
    if daemon_running():
        notify("Already running")
        return
    subprocess.Popen(
        "nohup python3 %s > /dev/null 2>&1 &" % _shq(str(DAEMON_PATH)),
        shell=True)
    time.sleep(0.3)
    notify("Enabled")


def _shq(s):
    return "'" + s.replace("'", "'\\''") + "'"


def cmd_stop():
    if not daemon_running():
        notify("Not running")
        return
    send_command("stop")
    for _ in range(20):
        if not daemon_running():
            break
        time.sleep(0.1)
    pid = daemon_pid()
    if pid and daemon_running():
        try:
            os.kill(pid, 9)
        except OSError:
            pass
    notify("Disabled")


def cmd_toggle():
    if daemon_running():
        cmd_stop()
    else:
        cmd_start()


def cmd_status():
    running = daemon_running()
    print("Running: %s" % ("yes" if running else "no"))
    if STATUS_PATH.exists():
        try:
            for line in STATUS_PATH.read_text(encoding="utf-8").splitlines():
                print(line)
        except OSError:
            pass
    else:
        cfg = read_config()
        vol = cfg.get("volume", {})
        pitch = cfg.get("pitch", {})
        print("profile=%s" % cfg.get("profile", {}).get("name", "typewriter"))
        print("mouse_profile=%s"
              % cfg.get("profile", {}).get("mouse_name", "g502x-wireless"))
        print("volume_key_down=%s" % vol.get("key_down", 1.5))
        print("volume_key_up=%s" % vol.get("key_up", 1.5))
        print("volume_mouse=%s" % vol.get("mouse", 1.5))
        print("pitch_enabled=%s" % ("true" if pitch.get("enabled", False) else "false"))
        print("pitch_lower=%s" % pitch.get("lower", -2))
        print("pitch_upper=%s" % pitch.get("upper", 2))


def cmd_list():
    for p in list_profiles():
        print(p)


def cmd_profile(args):
    if not args:
        cmd_list()
        return
    name = args[0]
    if name not in list_profiles():
        print("Unknown profile: %s" % name, file=sys.stderr)
        sys.exit(1)
    if is_mouse_profile(name):
        set_toml_value(CONFIG_PATH, "profile", "mouse_name", '"%s"' % name)
    else:
        set_toml_value(CONFIG_PATH, "profile", "name", '"%s"' % name)
    if daemon_running():
        send_command("profile %s" % name)
    notify("Profile: %s" % name)


def cmd_cycle():
    if not daemon_running():
        notify("Not running")
        return
    send_command("cycle")
    notify("Cycled profiles")


def cmd_volume(args):
    if not args:
        print("Usage: click-sounds volume <key_down|key_up|mouse> [value]",
              file=sys.stderr)
        sys.exit(1)
    which = args[0]
    if which not in ("key_down", "key_up", "mouse"):
        print("Unknown volume: %s" % which, file=sys.stderr)
        sys.exit(1)
    if len(args) < 2:
        cfg = read_config()
        print(cfg.get("volume", {}).get(which, 1.5))
        return
    try:
        v = float(args[1])
    except ValueError:
        print("Invalid volume: %s" % args[1], file=sys.stderr)
        sys.exit(1)
    v = max(0.0, min(2.0, v))
    set_toml_value(CONFIG_PATH, "volume", which, "%g" % v)
    if daemon_running():
        send_command("volume %s %g" % (which, v))
    notify("Volume %s: %g" % (which, v))


def cmd_pitch(args):
    if not args:
        cfg = read_config()
        pitch = cfg.get("pitch", {})
        state = "on" if pitch.get("enabled", False) else "off"
        print("Pitch: %s (range %s..%s)"
              % (state, pitch.get("lower", -2), pitch.get("upper", 2)))
        return
    arg = args[0]
    if arg in ("on", "off"):
        set_toml_value(CONFIG_PATH, "pitch", "enabled",
                       "true" if arg == "on" else "false")
        if daemon_running():
            send_command("pitch %s" % arg)
        notify("Pitch: %s" % arg)
    elif "," in arg:
        try:
            lo, hi = arg.split(",", 1)
            lo, hi = int(lo), int(hi)
        except ValueError:
            print("Usage: click-sounds pitch <lower>,<upper>", file=sys.stderr)
            sys.exit(1)
        set_toml_value(CONFIG_PATH, "pitch", "lower", str(lo))
        set_toml_value(CONFIG_PATH, "pitch", "upper", str(hi))
        set_toml_value(CONFIG_PATH, "pitch", "enabled", "true")
        if daemon_running():
            send_command("pitch %d,%d" % (lo, hi))
        notify("Pitch range: %d..%d" % (lo, hi))
    else:
        print("Usage: click-sounds pitch [on|off|<lower>,<upper>]",
              file=sys.stderr)
        sys.exit(1)


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip())
        sys.exit(1)
    cmd = sys.argv[1]
    args = sys.argv[2:]
    if cmd == "toggle":
        cmd_toggle()
    elif cmd == "start":
        cmd_start()
    elif cmd == "stop":
        cmd_stop()
    elif cmd == "status":
        cmd_status()
    elif cmd == "list":
        cmd_list()
    elif cmd == "profile":
        cmd_profile(args)
    elif cmd == "cycle":
        cmd_cycle()
    elif cmd == "volume":
        cmd_volume(args)
    elif cmd == "pitch":
        cmd_pitch(args)
    else:
        print("Unknown command: %s" % cmd, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()